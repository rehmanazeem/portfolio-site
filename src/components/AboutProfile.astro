---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import MailButton from './MailButton.astro';
import { copy } from '../lib/copy';
import { brand, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const a = copy[locale].about;
---
<section class="about-hero">
  <div class="about-copy">
    <p class="kicker eyebrow">{a.eyebrow}</p>
    <h1>{a.story.title}</h1>
    {a.story.paragraphs.map((p) => <p>{p}</p>)}
  </div>
  <p class="beyond">{a.story.beyond}</p>
  <figure class="portrait-frame">
    <Image class="portrait" src={portrait} alt={a.alt} width={360} widths={[360, 720]} sizes="(min-width: 48rem) 360px, 70vw" loading="eager" format="webp" quality={80} />
  </figure>
  <p class="portrait-caption"><span>{brand}</span><span>{a.caption}</span></p>
</section>

<section class="pane skills-pane">
  <h2>{a.skills.title}</h2>
  <div class="skill-groups">
    {a.skills.groups.map((g, i) => (
      <div class={`skill-group level-${i + 1}`}>
        <h3>{g.level}</h3>
        <ul class="chips">{g.items.map((it) => <li>{it}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<section class="cta-band">
  <p>{a.cv.text}</p>
  <MailButton locale={locale} kind="cv" class="btn btn-primary">{a.cv.button}</MailButton>
</section>

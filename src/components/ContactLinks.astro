---
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import MailButton from './MailButton.astro';
import { copy } from '../lib/copy';
import { links } from '../lib/profile';
import { useTranslations, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale].contact;
const t = useTranslations(locale);
---
<section class="contact-center">
  <p class="kicker eyebrow">{c.eyebrow}</p>
  <h1>{c.h1}</h1>
  <p class="lead">{c.lead}</p>
  <ul class="icon-row">
    <li><a class="icon-big" href={links.linkedin} rel="noopener"><Icon name="linkedin" size={26} /><span>{t('icon.linkedin')}</span></a></li>
    <li><a class="icon-big" href={links.github} rel="noopener"><Icon name="github" size={26} /><span>{t('icon.github')}</span></a></li>
    <li class="copy-item"><CopyEmail locale={locale} /></li>
    <li><MailButton locale={locale} class="icon-big"><Icon name="mail" size={26} /><span>{t('icon.mail')}</span></MailButton></li>
  </ul>
</section>

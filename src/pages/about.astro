---
import Base from '../layouts/Base.astro';
import AboutProfile from '../components/AboutProfile.astro';
import { copy } from '../lib/copy';
import { brand } from '../i18n/ui';
const a = copy['en'].about;
---
<Base locale="en" route="about" switchable title={`${a.title} | ${brand}`} description={a.description}>
  <AboutProfile locale="en" />
</Base>

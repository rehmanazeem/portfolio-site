---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { copy } from '../lib/copy';
import { brand } from '../i18n/ui';
const c = copy['en'].contact;
---
<Base locale="en" route="contact" switchable title={`${c.title} | ${brand}`} description={c.description}>
  <ContactLinks locale="en" />
</Base>

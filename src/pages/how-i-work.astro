---
import Base from '../layouts/Base.astro';
import { urlFor } from '../i18n/routes';
import { copy } from '../lib/copy';
import { brand, useTranslations } from '../i18n/ui';
const h = copy['en'].how;
const t = useTranslations('en');
---
<Base locale="en" route="how" switchable title={`${h.title} | ${brand}`} description={h.description}>
  <header class="how-head">
    <p class="kicker eyebrow">{h.title}</p>
    <h1>{h.lead}</h1>
  </header>
  <ol class="pipeline">
    {h.steps.map((s) => (
      <li class="stage"><strong>{s.name}</strong><p>{s.text}</p></li>
    ))}
  </ol>
  <p class="actions"><a class="btn btn-primary" href={urlFor('contact', 'en')}>{t('cta.contact')}</a></p>
</Base>

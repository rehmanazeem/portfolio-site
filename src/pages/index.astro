---
import Base from '../layouts/Base.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import { urlFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { copy } from '../lib/copy';
import { links } from '../lib/profile';
const c = copy['en'];
const t = useTranslations('en');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Azeem Ur Rehman',
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  jobTitle: 'Software Engineer',
  description: c.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Nürnberg', addressCountry: 'DE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Friedrich-Alexander-Universität Erlangen-Nürnberg' },
  sameAs: [links.linkedin, links.github],
};
---
<Base locale="en" route="home" switchable title={c.title} description={c.description} jsonLd={jsonLd}>
  <section class="hero hero-grid">
    <div class="hero-copy">
      <p class="kicker">{c.hook}</p>
      <h1>{c.h1}</h1>
      <p class="actions"><a class="btn btn-primary" href={urlFor('contact', 'en')}>{t('cta.talk')}</a></p>
    </div>
    <SystemDiagram locale="en" />
  </section>
</Base>
